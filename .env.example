# Copy to .env and adjust. Values here are defaults.
DATABASE_URL=sqlite:///mealtrack.db
# Email of the first user, seeded by scripts/init_db.py
SEED_USER_EMAIL=afguida@gmail.com

# Profile of the first user until phase 4 (then entered in /profilo).
PROFILE_SEX=M                # M or F
PROFILE_AGE=45
PROFILE_HEIGHT_CM=180
PROFILE_WEIGHT_KG=85
PROFILE_ACTIVITY=leggero     # sedentario, leggero, moderato, attivo, molto_attivo
PROFILE_DEFICIT_KCAL=500     # subtracted from TDEE for the daily target
PROFILE_PROTEIN_G_PER_KG=1.5
