# Copy to .env and adjust. Values here are defaults.
DATABASE_URL=sqlite:///mealtrack.db

# First user, seeded by scripts/init_db.py. Password only if set here.
SEED_USER_EMAIL=afguida@gmail.com
SEED_USER_PASSWORD=

# Sessions
SECRET_KEY=dev-secret-change-me   # long random string in production
COOKIE_SECURE=false               # true behind HTTPS
SESSION_DAYS=30
ALLOW_SIGNUP=true                 # false once family and friends are registered
