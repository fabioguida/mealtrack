# Copy to .env and adjust. Values here are defaults.
DATABASE_URL=sqlite:///mealtrack.db

# First user, seeded by scripts/init_db.py. Password only if set here.
SEED_USER_EMAIL=afguida@gmail.com
SEED_USER_PASSWORD=

# Sessions
SECRET_KEY=dev-secret-change-me   # long random string in production
COOKIE_SECURE=false               # true behind HTTPS
SESSION_DAYS=30
ALLOW_SIGNUP=true                 # false once family and friends are registered

# Meal photos
PORTION_ESTIMATOR=hand            # hand on the plate gives the scale; none to switch off
PHOTO_PROVIDER=none               # food recognition: none (default) or clip (needs ~1.5 GB RAM, requirements-photo.txt)
PHOTO_DIR=data/photos

# Emails: console (printed, default) or ses (Amazon SES with the instance role)
EMAIL_BACKEND=console
EMAIL_FROM="Meal Tracker <meal@verenovotech.com>"
APP_URL=http://127.0.0.1:8000
